# ------------------------------------------------------------
# Modelo de credenciais. Copie para ".env" e preencha.
# O ".env" NÃO é versionado (ver .gitignore) — cada integrante
# mantém o seu, com as credenciais do próprio ambiente.
# ------------------------------------------------------------

# PostgreSQL (mesmo container do Desafio 1: pgvector/pgvector:pg16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha

# MongoDB (mesmo container do Desafio 1)
MONGODB_URI=mongodb://localhost:27017

# LGPD (RF33) — salt do hashing e chave da pseudonimização.
# Gere valores aleatórios longos, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
LGPD_SALT_HASH=gere_um_valor_aleatorio
LGPD_CHAVE_PSEUDONIMO=gere_outro_valor_aleatorio

# OpenMetadata (RF27) — usados pelo script de publicação e pela ingestão.
# Login da interface (padrão da instalação local; troque se alterar):
OM_URL=http://localhost:8585/api
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
# Token JWT do bot de ingestão. Gerado por:
#   python openmetadata/publicar_metadados.py --token
OM_JWT_TOKEN=
