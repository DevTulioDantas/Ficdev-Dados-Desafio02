<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>rf24_ler_parquet</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>RF24: le o Parquet das interacoes e agrega por tipo de interacao (medicao de tempo de leitura)</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 13:30:00.000</created_date>
    <modified_date>2026/09/27 13:30:00.000</modified_date>
  </info>
    <transform>
    <type>GetVariable</type>
    <name>Arquivo parquet</name>
    <fields>
      <field>
        <name>arquivo</name>
        <variable>${PROJECT_HOME}/dados/silver/parquet/interacoes_usuarios.snappy.parquet</variable>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileInput</type>
    <name>Ler Parquet</name>
    <filename_field>arquivo</filename_field>
    <metadata_filename>${PROJECT_HOME}/dados/silver/parquet/interacoes_usuarios.snappy.parquet</metadata_filename>
    <nulls_when_empty>N</nulls_when_empty>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>MemoryGroupBy</type>
    <name>Agregar por tipo</name>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>tipo_interacao</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>qtd_interacoes</aggregate>
        <subject>tipo_interacao</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>tempo_consumido_total</aggregate>
        <subject>tempo_consumido</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>percentual_conclusao_medio</aggregate>
        <subject>percentual_conclusao</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Resultado</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>800</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Arquivo parquet</from>
      <to>Ler Parquet</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler Parquet</from>
      <to>Agregar por tipo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregar por tipo</from>
      <to>Resultado</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
