<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>comparar_runtimes</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>RF25: le as saidas Parquet do engajamento_beam de cada runtime (local, beam-direct, spark-local) e mostra o resultado lado a lado para provar que a regra de negocio e a mesma</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 13:30:00.000</created_date>
    <modified_date>2026/09/27 13:30:00.000</modified_date>
  </info>
        <transform>
    <type>GetFileNames</type>
    <name>Listar arquivos parquet</name>
    <file>
      <name>${PROJECT_HOME}/dados/gold/beam</name>
      <filemask>.*\.parquet</filemask>
      <exclude_filemask/>
      <file_required>N</file_required>
      <include_subfolders>Y</include_subfolders>
    </file>
    <filter>
      <filterfiletype>only_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <rownum_field/>
    <filename_Field/>
    <wildcard_Field/>
    <exclude_wildcard_Field/>
    <filefield>N</filefield>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>Y</raiseAnExceptionIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ReplaceString</type>
    <name>Identificar runtime</name>
    <fields>
      <field>
        <in_stream_name>path</in_stream_name>
        <out_stream_name>runtime</out_stream_name>
        <use_regex>Y</use_regex>
        <replace_string>^.*[\\/]</replace_string>
        <replace_by_string/>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileInput</type>
    <name>Ler resultados</name>
    <filename_field>filename</filename_field>
    <metadata_filename>${PROJECT_HOME}/dados/gold/beam/local/engajamento_por_tipo.snappy.parquet</metadata_filename>
    <nulls_when_empty>N</nulls_when_empty>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>MemoryGroupBy</type>
    <name>Consolidar por runtime</name>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>tipo_interacao</name>
      </field>
      <field>
        <name>runtime</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>qtd_interacoes</aggregate>
        <subject>qtd_interacoes</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>tempo_consumido_total</aggregate>
        <subject>tempo_consumido_total</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>percentual_conclusao_medio</aggregate>
        <subject>percentual_conclusao_medio</subject>
        <type>FIRST</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>arquivos</aggregate>
        <subject>short_filename</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>672</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SortRows</type>
    <name>Ordenar tipo e runtime</name>
    <directory>%%java.io.tmpdir%%</directory>
    <sort_prefix>out</sort_prefix>
    <sort_size>1000000</sort_size>
    <free_memory/>
    <unique_rows>N</unique_rows>
    <compress>N</compress>
    <compress_variables/>
    <fields>
      <field>
        <name>tipo_interacao</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
      <field>
        <name>runtime</name>
        <ascending>Y</ascending>
        <case_sensitive>N</case_sensitive>
        <collator_enabled>N</collator_enabled>
        <collator_strength>0</collator_strength>
        <presorted>N</presorted>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>864</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Comparacao</name>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${PROJECT_HOME}/beam/evidencias/comparacao_runtimes</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension>csv</extension>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>tipo_interacao</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>runtime</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>qtd_interacoes</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>tempo_consumido_total</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>percentual_conclusao_medio</name>
        <type>Number</type>
        <format>0.00</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>arquivos</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1056</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Listar arquivos parquet</from>
      <to>Identificar runtime</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Identificar runtime</from>
      <to>Ler resultados</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler resultados</from>
      <to>Consolidar por runtime</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Consolidar por runtime</from>
      <to>Ordenar tipo e runtime</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ordenar tipo e runtime</from>
      <to>Comparacao</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
