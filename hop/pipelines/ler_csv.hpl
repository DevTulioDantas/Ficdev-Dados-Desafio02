<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>rf24_ler_csv</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>RF24: le o CSV das interacoes e agrega por tipo de interacao (medicao de tempo de leitura)</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 13:30:00.000</created_date>
    <modified_date>2026/09/27 13:30:00.000</modified_date>
  </info>
    <transform>
    <type>CSVInput</type>
    <name>Ler CSV</name>
    <filename>${PROJECT_HOME}/dados/silver/csv/interacoes_usuarios.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <fields>
      <field>
        <name>usuario_id</name>
        <type>Integer</type>
        <format>#</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>conteudo_id</name>
        <type>Integer</type>
        <format>#</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>tipo_interacao</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>data_hora</name>
        <type>Timestamp</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>tempo_consumido</name>
        <type>Integer</type>
        <format>#</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>percentual_conclusao</name>
        <type>Number</type>
        <format>#.##</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
      <field>
        <name>avaliacao_atribuida</name>
        <type>Integer</type>
        <format>#</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>data_hora_processamento</name>
        <type>Timestamp</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
      <field>
        <name>id_execucao</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <currency/>
        <decimal></decimal>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>MemoryGroupBy</type>
    <name>Agregar por tipo</name>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>tipo_interacao</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>qtd_interacoes</aggregate>
        <subject>tipo_interacao</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>tempo_consumido_total</aggregate>
        <subject>tempo_consumido</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>percentual_conclusao_medio</aggregate>
        <subject>percentual_conclusao</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Resultado</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler CSV</from>
      <to>Agregar por tipo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregar por tipo</from>
      <to>Resultado</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
