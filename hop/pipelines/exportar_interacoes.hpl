<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>rf24_exportar_interacoes</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>RF24: exporta o mesmo recorte da Silver (interacoes) para CSV e para Parquet, para comparar tamanho e tempo de leitura</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 13:30:00.000</created_date>
    <modified_date>2026/09/27 13:30:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Ler silver interacoes</name>
    <sql>SELECT usuario_id, conteudo_id, tipo_interacao, data_hora,
       tempo_consumido, percentual_conclusao, avaliacao_atribuida,
       data_hora_processamento, id_execucao
FROM silver.interacoes_usuarios</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>pg_desafio</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>192</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Gravar CSV</name>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${PROJECT_HOME}/dados/silver/csv/interacoes_usuarios</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension>csv</extension>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>usuario_id</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>conteudo_id</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>tipo_interacao</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>data_hora</name>
        <type>Timestamp</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>tempo_consumido</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>percentual_conclusao</name>
        <type>BigNumber</type>
        <format>0.00</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>avaliacao_atribuida</name>
        <type>Integer</type>
        <format>0</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>data_hora_processamento</name>
        <type>Timestamp</type>
        <format>yyyy-MM-dd HH:mm:ss</format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
      <field>
        <name>id_execucao</name>
        <type>String</type>
        <format></format>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal></decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <roundingType>half_even</roundingType>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>416</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileOutput</type>
    <name>Gravar Parquet</name>
    <filename_base>${PROJECT_HOME}/dados/silver/parquet/interacoes_usuarios</filename_base>
    <filename_ext>parquet</filename_ext>
    <filename_include_date>N</filename_include_date>
    <filename_include_time>N</filename_include_time>
    <filename_include_datetime>N</filename_include_datetime>
    <filename_datetime_format>yyyyMMdd-HHmmss</filename_datetime_format>
    <filename_include_copy>N</filename_include_copy>
    <filename_include_split>N</filename_include_split>
    <filename_split_size/>
    <filename_create_parent_folders>Y</filename_create_parent_folders>
    <filename_compression_before_extension>Y</filename_compression_before_extension>
    <compression_codec>SNAPPY</compression_codec>
    <fields/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>416</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler silver interacoes</from>
      <to>Gravar CSV</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler silver interacoes</from>
      <to>Gravar Parquet</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
