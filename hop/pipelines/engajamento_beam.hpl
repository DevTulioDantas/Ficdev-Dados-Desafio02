<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>RUNTIME</name>
        <description>Nome do runtime usado na execucao (local, beam-direct, spark-local). Define a pasta de saida.</description>
        <default_value>local</default_value>
      </parameter>
    </parameters>
    <name>engajamento_beam</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>RF25: engajamento por tipo de interacao (Parquet -&gt; agregacao -&gt; Parquet). O mesmo pipeline roda nos runtimes local, Beam Direct e Beam Spark, trocando so a Pipeline Run Configuration.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 13:30:00.000</created_date>
    <modified_date>2026/09/27 13:30:00.000</modified_date>
  </info>
      <transform>
    <type>RowGenerator</type>
    <name>Gerar 1 linha</name>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>1</limit>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Caminho do parquet</name>
    <fields>
      <field>
        <name>arquivo</name>
        <variable>${PROJECT_HOME}/dados/silver/parquet/interacoes_usuarios.snappy.parquet</variable>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileInput</type>
    <name>Ler Parquet</name>
    <filename_field>arquivo</filename_field>
    <metadata_filename>${PROJECT_HOME}/dados/silver/parquet/interacoes_usuarios.snappy.parquet</metadata_filename>
    <nulls_when_empty>N</nulls_when_empty>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>MemoryGroupBy</type>
    <name>Agregar por tipo</name>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>tipo_interacao</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>qtd_interacoes</aggregate>
        <subject>tipo_interacao</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>tempo_consumido_total</aggregate>
        <subject>tempo_consumido</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>percentual_conclusao_medio</aggregate>
        <subject>percentual_conclusao</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>672</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ParquetFileOutput</type>
    <name>Gravar resultado</name>
    <filename_base>${PROJECT_HOME}/dados/gold/beam/${RUNTIME}/engajamento_por_tipo</filename_base>
    <filename_ext>parquet</filename_ext>
    <filename_include_date>N</filename_include_date>
    <filename_include_time>N</filename_include_time>
    <filename_include_datetime>N</filename_include_datetime>
    <filename_datetime_format>yyyyMMdd-HHmmss</filename_datetime_format>
    <filename_include_copy>N</filename_include_copy>
    <filename_include_split>N</filename_include_split>
    <filename_split_size/>
    <filename_create_parent_folders>Y</filename_create_parent_folders>
    <filename_compression_before_extension>Y</filename_compression_before_extension>
    <compression_codec>SNAPPY</compression_codec>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>864</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Gerar 1 linha</from>
      <to>Caminho do parquet</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Caminho do parquet</from>
      <to>Ler Parquet</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Ler Parquet</from>
      <to>Agregar por tipo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agregar por tipo</from>
      <to>Gravar resultado</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
