<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
      <parameter>
        <name>ID_EXECUCAO</name>
        <description>Identificador da execução, recebido do workflow</description>
        <default_value>manual</default_value>
      </parameter>
    </parameters>
    <name>gold_dim_usuario</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carga da dimensao de usuarios (gold.dim_usuario), sem dados pessoais</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 13:30:00.000</created_date>
    <modified_date>2026/09/27 13:30:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Ler usuarios e interacoes</name>
    <sql>WITH referencia AS (
  SELECT MAX(data_hora) AS data_referencia
  FROM silver.interacoes_usuarios
), resumo AS (
  SELECT usuario_id
       , MIN(data_hora)::DATE      AS data_primeira_interacao
       , MAX(data_hora)::DATE      AS data_ultima_interacao
       , COUNT(*)                  AS total_interacoes
       , COUNT(DISTINCT conteudo_id) AS conteudos_distintos
  FROM silver.interacoes_usuarios
  GROUP BY usuario_id
)
SELECT u.usuario_id
     , r.data_primeira_interacao
     , r.data_ultima_interacao
     , COALESCE(r.total_interacoes, 0)::INTEGER    AS total_interacoes
     , COALESCE(r.conteudos_distintos, 0)::INTEGER AS conteudos_distintos
     , COALESCE(r.data_ultima_interacao &gt;= (ref.data_referencia - INTERVAL '30 days')::DATE, FALSE) AS usuario_ativo
FROM public.usuario u
LEFT JOIN resumo r ON r.usuario_id = u.usuario_id
CROSS JOIN referencia ref</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>pg_desafio</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SystemInfo</type>
    <name>Data hora processamento</name>
    <fields>
      <field>
        <name>data_hora_processamento</name>
        <type>system date (fixed)</type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Execucao gold</name>
    <fields>
      <field>
        <name>id_execucao</name>
        <variable>${ID_EXECUCAO}</variable>
        <type>String</type>
        <format/>
