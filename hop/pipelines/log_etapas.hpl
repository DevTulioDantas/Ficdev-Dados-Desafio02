<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>log_etapas</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>RF22 - grava inicio, termino, duracao e resultado de cada action do workflow em auditoria.log_etapas (executado pelo metadado Workflow Log log_carga_completa)</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/28 13:30:00.000</created_date>
    <modified_date>2026/09/28 13:30:00.000</modified_date>
  </info>
  <transform>
    <type>WorkflowLogging</type>
    <name>Log do workflow</name>
    <log_transforms>Y</log_transforms>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Selecionar campos</name>
    <fields>
      <field>
        <name>workflowName</name>
        <rename>workflow</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>workflowLogChannelId</name>
        <rename>id_canal_workflow</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>workflowStart</name>
        <rename>inicio_workflow</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>actionNr</name>
        <rename>ordem</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>actionName</name>
        <rename>etapa</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>actionResult</name>
        <rename>resultado</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>actionErrors</name>
        <rename>erros</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>actionLogDate</name>
        <rename>termino</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>actionDuration</name>
        <rename>duracao_ms</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Gravar log_etapas</name>
    <connection>pg_desafio</connection>
    <schema>auditoria</schema>
    <table>log_etapas</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>Y</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Log do workflow</from>
      <to>Selecionar campos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Selecionar campos</from>
      <to>Gravar log_etapas</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
